# Copy this file to .env and replace the placeholders with real values.
# .env is git-ignored; never commit real keys, and never ship them to static/.
# Placeholder values are treated as "not configured" by the app.

# DeepSeek is only needed to generate new stories (generate.py, build_bank.py,
# add_questions.py).  Reading the existing library works without it.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-flash

# Optional Supabase storage for stories (see README "Supabase storage").
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_secret_your-secret-key
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# SUPABASE_STORIES_TABLE=stories
# SUPABASE_TIMEOUT=20

# Storage backend: auto (default: Supabase when configured), files or supabase.
# STORY_BACKEND=auto
# STORY_LOCAL_MIRROR=1
